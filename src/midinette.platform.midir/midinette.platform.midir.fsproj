<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Rust shim over midir, built with cargo (host RID only for local dev) -->
    <MidirNativeDir>$(MSBuildThisFileDirectory)..\..\native\midinette-midir-ffi\</MidirNativeDir>
    <MidirCargoProfile Condition="'$(MidirCargoProfile)' == ''">release</MidirCargoProfile>
    <MidirNativeLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmidinette_midir.dylib</MidirNativeLibName>
    <MidirNativeLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libmidinette_midir.so</MidirNativeLibName>
    <MidirNativeLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">midinette_midir.dll</MidirNativeLibName>
    <MidirNativeLibPath>$(MidirNativeDir)target\$(MidirCargoProfile)\$(MidirNativeLibName)</MidirNativeLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Native.fs" />
    <Compile Include="MidirPlatform.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\midinette\midinette.fsproj" />
  </ItemGroup>

  <!-- set MidinetteSkipCargo=true to use a prebuilt native lib (e.g. from CI artifacts) -->
  <Target Name="MidirCargoBuild" BeforeTargets="BeforeBuild" Condition="'$(MidinetteSkipCargo)' != 'true'">
    <PropertyGroup>
      <_CargoProfileArg Condition="'$(MidirCargoProfile)' == 'release'">--release</_CargoProfileArg>
    </PropertyGroup>
    <Exec Command="cargo build $(_CargoProfileArg) --manifest-path &quot;$(MidirNativeDir)Cargo.toml&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(MidirNativeLibPath)" Link="$(MidirNativeLibName)" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="'$(MidirNativeLibName)' != ''" />
  </ItemGroup>
</Project>
